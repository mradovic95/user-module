<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.comex</groupId>
	<artifactId>user-module</artifactId>
	<version>0.0.9-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>user-module</name>
	<description>User Module - Multi-module authentication and user management</description>

	<modules>
		<module>user-module-core</module>
		<module>user-module-infrastructure-postgre</module>
		<module>user-module-infrastructure-dynamodb</module>
		<module>user-module-endpoint</module>
		<module>user-module-configuration</module>
		<module>user-module-authorization-server</module>
		<module>user-module-starter-dynamodb</module>
		<module>user-module-starter-postgre</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<org.springdoc.springdoc-openapi-starter-webmvc-ui.version>3.1.1</org.springdoc.springdoc-openapi-starter-webmvc-ui.version>
		<io.jsonwebtoken.version>0.13.0</io.jsonwebtoken.version>
		<software.amazon.awssdk.version>2.30.2</software.amazon.awssdk.version>
		<!-- Spring AI community MCP security (0.1.x targets the Spring AI 2.0 / Spring Boot 4 line) -->
		<org.springaicommunity.mcp-security.version>0.1.14</org.springaicommunity.mcp-security.version>
	</properties>

	<distributionManagement>
		<repository>
			<id>user-module</id>
			<url>https://com-comex-925199373191.d.codeartifact.us-east-2.amazonaws.com/maven/user-module/</url>
		</repository>
		<snapshotRepository>
			<id>user-module</id>
			<url>https://com-comex-925199373191.d.codeartifact.us-east-2.amazonaws.com/maven/user-module/</url>
		</snapshotRepository>
	</distributionManagement>

	<dependencyManagement>
		<dependencies>
			<!-- Internal modules -->
			<dependency>
				<groupId>com.comex</groupId>
				<artifactId>user-module-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.comex</groupId>
				<artifactId>user-module-infrastructure-postgre</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.comex</groupId>
				<artifactId>user-module-infrastructure-dynamodb</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.comex</groupId>
				<artifactId>user-module-endpoint</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.comex</groupId>
				<artifactId>user-module-configuration</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.comex</groupId>
				<artifactId>user-module-authorization-server</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- MCP authorization server support (Dynamic Client Registration, resource indicators) -->
			<dependency>
				<groupId>org.springaicommunity</groupId>
				<artifactId>mcp-authorization-server</artifactId>
				<version>${org.springaicommunity.mcp-security.version}</version>
			</dependency>

			<!-- JWT -->
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-api</artifactId>
				<version>${io.jsonwebtoken.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-impl</artifactId>
				<version>${io.jsonwebtoken.version}</version>
			</dependency>
			<dependency>
				<groupId>io.jsonwebtoken</groupId>
				<artifactId>jjwt-jackson</artifactId>
				<version>${io.jsonwebtoken.version}</version>
			</dependency>

			<!-- AWS SDK -->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>dynamodb</artifactId>
				<version>${software.amazon.awssdk.version}</version>
			</dependency>
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>dynamodb-enhanced</artifactId>
				<version>${software.amazon.awssdk.version}</version>
			</dependency>

			<!-- Documentation -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${org.springdoc.springdoc-openapi-starter-webmvc-ui.version}</version>
			</dependency>

			<!-- Testcontainers (org.testcontainers:testcontainers-*) is version-managed by the Spring Boot
			     parent BOM; modules declare the artifacts without a version. -->

			<!-- Lombok: version comes from the Spring Boot parent (${lombok.version}); keep it provided
			     so it does not leak into consumers' classpaths. -->
			<dependency>
				<groupId>org.projectlombok</groupId>
				<artifactId>lombok</artifactId>
				<version>${lombok.version}</version>
				<scope>provided</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- javac 23+ no longer discovers annotation processors from the classpath implicitly,
				     so Lombok and the Boot configuration processor must be declared explicitly.
				     Versions are resolved from dependency management (Spring Boot BOM). -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
							</path>
							<path>
								<groupId>org.springframework.boot</groupId>
								<artifactId>spring-boot-configuration-processor</artifactId>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Mockito's inline mock maker attaches a Java agent at runtime; JDK 21+ warns unless this flag is set. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>-XX:+EnableDynamicAgentLoading</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
